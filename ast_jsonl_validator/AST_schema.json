{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Modelica RAG Schema v1 (no-PDF)",
  "type": "object",
  "properties": {
    "collections": {
      "type": "object",
      "properties": {
        "ast_record": {
          "type": "object",
          "required": [
            "id","kind","name","fqn","package_path",
            "metadata","code_text",
            "parameters","components","equations","connections",
            "inheritance","neighbors","provenance"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 16 },
            "kind": { "type": "string", "enum": ["package","model","block","connector","function","record","type","class"] },
            "name": { "type": "string", "minLength": 1 },
            "fqn": { "type": "string", "pattern": "^[A-Za-z0-9_.]+$" },
            "package_path": { "type": "array", "items": { "type": "string" }, "minItems": 1 },

            "metadata": {
              "type": "object",
              "required": ["file_path","line_range","timestamp","checksum","version"],
              "properties": {
                "file_path": { "type": "string" },
                "line_range": { "type": "object", "required": ["start","end"], "properties": {
                  "start": { "type": "integer", "minimum": 1 },
                  "end": { "type": "integer", "minimum": 1 }
                }},
                "timestamp": { "type": "string", "format": "date-time" },
                "checksum": { "type": "string" },
                "version": { "type": "string" }
              }
            },

            "code_text": { "type": "string", "minLength": 50 },

            "documentation": {
              "type": "object",
              "properties": { "info": { "type": "string" }, "revisions": { "type": "string" } },
              "additionalProperties": false
            },

            "inheritance": {
              "type": "object",
              "required": ["extends","imports","replaceables"],
              "properties": {
                "extends": { "type": "array", "items": {
                  "type": "object", "required": ["base_class"],
                  "properties": { "base_class": { "type": "string" }, "modifications": { "type": "object" } }
                }},
                "imports": { "type": "array", "items": {
                  "type": "object", "required": ["package","kind"],
                  "properties": {
                    "package": { "type": "string" },
                    "kind": { "type": "string", "enum": ["qualified","unqualified","renamed"] }
                  }
                }},
                "replaceables": { "type": "array", "items": {
                  "type": "object", "required": ["name"],
                  "properties": { "name": { "type": "string" }, "constrainedby": { "type": "string" } }
                }}
              }
            },

            "resolved_modifiers": {
              "type": "array",
              "items": {
                "type": "object", "required": ["name","resolved_value","source"],
                "properties": {
                  "name": { "type": "string" },
                  "resolved_value": {},
                  "source": { "type": "string", "enum": ["extends","redeclare","component"] }
                }
              }
            },

            "components": { "type": "array", "items": {
              "type": "object", "required": ["name","type","prefixes"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "prefixes": { "type": "array", "items": {
                  "type": "string",
                  "enum": ["parameter","constant","discrete","input","output","flow","stream","public","protected","final","replaceable","inner","outer"]
                }},
                "modifications": { "type": "object" },
                "array_dims": { "type": ["array","null"], "items": { "type": "integer", "minimum": 1 } },
                "comment": { "type": "string" },
                "condition": { "type": ["string","null"] }
              }
            }},

            "parameters": { "type": "array", "items": {
              "type": "object", "required": ["name","type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "default": {}, "unit": { "type": "string" }, "displayUnit": { "type": "string" },
                "min": {}, "max": {}, "nominal": {}, "quantity": { "type": "string" },
                "description": { "type": "string" },
                "prefixes": { "type": "array", "items": { "type": "string", "enum": ["parameter","final"] } }
              }
            }},

            "variables": { "type": "array", "items": {
              "type": "object", "required": ["name","type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "prefixes": { "type": "array", "items": { "type": "string", "enum": ["input","output","flow","stream","discrete"] } },
                "start": {}, "fixed": { "type": ["boolean","null"] },
                "binding_equation": { "type": ["string","null"] },
                "attributes": { "type": "object", "properties": { "unit": { "type": "string" }, "min": {}, "max": {}, "nominal": {} } }
              }
            }},

            "equations": {
              "type": "array", "minItems": 1, "items": {
                "type": "object", "required": ["section_type","items"],
                "properties": {
                  "section_type": { "type": "string", "enum": ["equation","initial_equation","algorithm","initial_algorithm"] },
                  "items": { "type": "array", "items": {
                    "type": "object", "required": ["str"],
                    "properties": {
                      "str": { "type": "string", "minLength": 3 },
                      "vars": { "type": "array", "items": { "type": "string" } },
                      "guards": { "type": "array", "items": { "type": "string" } },
                      "ops": { "type": "array", "items": { "type": "string",
                        "enum": ["pre","edge","change","noEvent","sample","hold","smooth","homotopy"] } },
                      "phase": { "type": "string", "enum": ["initial","runtime","both"], "default": "runtime" },
                      "location": { "type": "object", "properties": {
                        "line_start": { "type": "integer", "minimum": 1 },
                        "line_end": { "type": "integer", "minimum": 1 }
                      }}
                    }
                  }}
                }
              }
            },

            "connections": { "type": "array", "items": {
              "type": "object", "required": ["from_connector","to_connector"],
              "properties": { "from_connector": { "type": "string" }, "to_connector": { "type": "string" } }
            }},

            "physical_domain": { "type": "object", "properties": {
              "domain": { "type": "string", "enum": ["electrical","mechanical_translational","mechanical_rotational","thermal","fluid","control","multi-domain"] },
              "ports": { "type": "array", "items": {
                "type": "object", "required": ["name","type"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "direction": { "type": "string", "enum": ["input","output","bidirectional",""] },
                  "variables": { "type": "array", "items": {
                    "type": "object", "required": ["name","kind"],
                    "properties": { "name": { "type": "string" }, "kind": { "type": "string", "enum": ["potential","flow","stream"] } }
                  }}
                }
              }},
              "quantities": { "type": "array", "items": {
                "type": "object", "required": ["variable","quantity","unit","value_type"],
                "properties": {
                  "variable": { "type": "string" }, "quantity": { "type": "string" }, "unit": { "type": "string" },
                  "value_type": { "type": "string", "enum": ["parameter","variable","constant"] }
                }
              }}
            }},

            "stream_info": { "type": "object", "properties": {
              "has_stream": { "type": "boolean", "default": false },
              "ops": { "type": "array", "items": { "type": "string", "enum": ["inStream","actualStream"] } },
              "medium": { "type": ["string","null"] },
              "mixing_equations": { "type": "boolean" }
            }},

            "annotations": { "type": "object", "properties": {
              "experiment": { "type": "object", "properties": { "StartTime": {}, "StopTime": {}, "Tolerance": {}, "Interval": {} } },
              "state_select": { "type": "string", "enum": ["never","avoid","default","prefer","always"] },
              "inline": { "type": "string", "enum": ["true","false","LateInline",""] },
              "derivative": { "type": "string" },
              "inverse": { "type": "string" },
              "connector_sizing": { "type": ["boolean","null"] },
              "dialog": { "type": "object" }
            }, "additionalProperties": false },

            "neighbors": {
              "type": "object", "required": ["uses","used_by"],
              "properties": { "uses": { "type": "array", "items": { "type": "string" } }, "used_by": { "type": "array", "items": { "type": "string" } } }
            },

            "provenance": {
              "type": "object", "required": ["repo","commit","file_path","line_range","version","hash"],
              "properties": {
                "repo": { "type": "string" },
                "commit": { "type": "string" },
                "file_path": { "type": "string" },
                "line_range": { "type": "object", "required": ["start","end"], "properties": {
                  "start": { "type": "integer", "minimum": 1 },
                  "end": { "type": "integer", "minimum": 1 }
                }},
                "version": { "type": "string" },
                "hash": { "type": "string" }
              }
            },

            "statistics": { "type": "object", "properties": {
              "parameters_count": { "type": "integer", "minimum": 0 },
              "components_count": { "type": "integer", "minimum": 0 },
              "equations_count": { "type": "integer", "minimum": 0 },
              "connections_count": { "type": "integer", "minimum": 0 },
              "variables_count": { "type": "integer", "minimum": 0 },
              "code_lines": { "type": "integer", "minimum": 0 }
            }}
          },
          "additionalProperties": false
        },

        "equation_record": {
          "type": "object",
          "required": ["id","owner_fqn","equation","vars","location","provenance"],
          "properties": {
            "id": { "type": "string" },
            "owner_fqn": { "type": "string" },
            "equation": { "type": "string", "minLength": 3 },
            "vars": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
            "section_type": { "type": "string", "enum": ["equation","initial_equation","algorithm","initial_algorithm"] },
            "ops": { "type": "array", "items": { "type": "string",
              "enum": ["pre","edge","change","noEvent","sample","hold","smooth","homotopy"] } },
            "location": { "type": "object", "required": ["file_path","line_start","line_end"],
              "properties": { "file_path": { "type": "string" }, "line_start": { "type": "integer","minimum":1 }, "line_end": { "type": "integer","minimum":1 } } },
            "links": { "type": "array", "items": { "type": "object",
              "properties": { "type": { "type": "string" }, "ref": { "type": "string" } } } },
            "provenance": { "type": "object", "required": ["repo","commit","version","hash"],
              "properties": { "repo": { "type": "string" }, "commit": { "type": "string" }, "version": { "type": "string" }, "hash": { "type": "string" } } }
          },
          "additionalProperties": false
        },

        "example_record": {
          "type": "object",
          "required": ["id","title","code","fqn_mentions","quality"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "code": { "type": "string", "minLength": 20 },
            "fqn_mentions": { "type": "array", "items": { "type": "string" } },
            "probes": { "type": "array", "items": { "type": "object",
              "properties": { "name": { "type": "string" }, "series_ref": { "type": "string" } } } },
            "quality": { "type": "object", "required": ["build_ok","sim_ok"],
              "properties": { "build_ok": { "type": "boolean" }, "sim_ok": { "type": "boolean" } } },
            "links": { "type": "array", "items": { "type": "object",
              "properties": { "type": { "type": "string" }, "ref": { "type": "string" } } } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "validation_rules": {
      "type": "object",
      "properties": {
        "no_duplicate_id": { "type": "boolean", "const": true },
        "ast_required_nonempty": { "type": "array", "items": { "type": "string", "enum": ["parameters","components","equations"] } },
        "require_provenance": { "type": "boolean", "const": true },
        "fluid_require_medium_resolution": { "type": "boolean", "const": true },
        "min_equation_vars": { "type": "integer", "const": 2 }
      }
    }
  },
  "required": ["collections","validation_rules"],
  "additionalProperties": false
}
